; The Folded Observatory — an original Perspective Crime miniature.
config_version=5

[application]
config/name="The Folded Observatory"
config/description="A quiet journey through impossible space. Turn the world, join its silhouettes, and awaken three celestial lights."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=600

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.025, 0.08, 0.11, 1)
